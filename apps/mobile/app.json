{
  "expo": {
    "name": "NÔDJUNTA PAY",
    "slug": "nodjunta-pay",
    "scheme": "nodjunta",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.nodjuntapay.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.nodjuntapay.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "A NÔDJUNTA PAY usa a câmara para ler QR Codes de pagamento."
        }
      ]
    ]
  }
}
