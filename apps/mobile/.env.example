# URL da API (Render em produção, ou o URL público do Replit em desenvolvimento).
# Um telemóvel real não alcança "localhost".
EXPO_PUBLIC_API_URL=https://SEU-SERVICO.onrender.com
# Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave PÚBLICA (anon). NUNCA a service_role.
EXPO_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon
# Só desenvolvimento: mostra botões para simular a confirmação de depósitos/levantamentos.
# Em produção deve ser false (ou ficar em falta).
EXPO_PUBLIC_SANDBOX_TOOLS=true
