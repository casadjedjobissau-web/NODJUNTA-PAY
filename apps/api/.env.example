NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
DEFAULT_CURRENCY=XOF
# Supabase local: URL e service_role key aparecem em `npx supabase status`.
# A service_role key NUNCA vai para o app mobile nem para o GitHub.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key
# Simula confirmações de depósito/levantamento. A API recusa arrancar com true em production.
SANDBOX_ENABLED=true
# Segredo do webhook do provedor sandbox (mínimo 32 caracteres). Não definir em production.
WEBHOOK_SECRET_SANDBOX=gere-um-segredo-aleatorio-com-mais-de-32-caracteres
# Pimenta dos PIN (mínimo 32 caracteres). Gere com: openssl rand -hex 32
# GUARDE NUM COFRE: se a perder ou trocar, todos os PIN deixam de funcionar.
PIN_PEPPER=gere-com-openssl-rand-hex-32-e-nunca-publique
# on = o PIN é exigido em transferências, pagamentos e levantamentos.
# off = SÓ desenvolvimento, até a app enviar o PIN. A API recusa arrancar com off em production.
PIN_ENFORCEMENT=off
# Números de suporte mostrados na app (formato internacional, separados por vírgulas)
SUPPORT_PHONES=+245956191968,+245956656700
